Options -Indexes
DirectoryIndex index.html

RewriteEngine On

# Clean URL for the notes article: /notes/the-prince -> notes/the-prince.html
RewriteRule ^notes/the-prince/?$ notes/the-prince.html [NC,L]

# Serve clean URLs without the .html extension (also covers nested paths)
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^([^\.]+)$ $1.html [NC,L]
